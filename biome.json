{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/test/fixtures",
      "!**/test/__snapshots__",
      "!apps/desktop/src-tauri",
      "!tools/oracle/renv",
      "!tools/oracle/renv.lock",
      "!tools/oracle/cases",
      "!tools/nist/raw"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" }
    }
  },
  "plugins": [
    {
      "path": "./tools/lint/typedArrayFromMap.grit",
      "includes": ["**/packages/stats/src/**", "**/packages/model/src/formulaStats.ts"]
    },
    {
      "path": "./tools/lint/closureInLoop.grit",
      "includes": [
        "**/packages/stats/src/gpl/covTrob.ts",
        "**/packages/stats/src/gpl/rowDistance.ts",
        "**/packages/stats/src/multivariate/cluster.ts",
        "**/packages/stats/src/multivariate/ellipse.ts",
        "**/packages/stats/src/smoothing/contour.ts",
        "**/packages/stats/src/smoothing/density.ts",
        "**/packages/stats/src/smoothing/hexbin.ts",
        "**/packages/stats/src/smoothing/kde2d.ts",
        "**/packages/stats/src/arrays.ts",
        "**/packages/model/src/formulaStats.ts"
      ]
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
