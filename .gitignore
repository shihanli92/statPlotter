node_modules/
# Build output only; a bare `dist/` would also hide source folders such as packages/stats/src/dist.
apps/*/dist/
coverage/
*.tsbuildinfo
.DS_Store

# Tauri / Rust
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# R oracle: renv library is machine-local; the lockfile is committed
tools/oracle/renv/library/
tools/oracle/renv/staging/
tools/oracle/.Rhistory

# NIST raw downloads; parsed fixtures are committed
tools/nist/raw/

# Papers and their source data kept locally for checking (not redistributed); the extracted
# numbers used in tests are committed with a citation.
/source_data/
/source_data_*/
/*_source_data/
/*.pdf

# Git worktrees made for parallel agents
.claude/worktrees/

# Playwright
apps/e2e/test-results/
apps/e2e/playwright-report/
apps/e2e/blob-report/

# Private Prism files kept in the checkout root for manual checks (never committed); the
# fixtures under packages/ and apps/ stay tracked.
/*.pzfx
