// The public demo on Cloudflare (a Worker serving static assets): Cloudflare's Git integration on
// the public repository builds the web app (see docs/PUBLISHING.md for the build command) and then
// runs `npx wrangler deploy`, which reads this file. The assets are the production build; its
// `_headers` file (copied from apps/web/public) gives every response the app's security headers.
{
  "name": "statplotter",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./apps/web/dist"
  }
}
