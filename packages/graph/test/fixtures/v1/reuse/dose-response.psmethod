   "zid000109": {
    "kind": "analysis",
    "id": "zid000109",
    "name": "Monte Carlo: power of an unpaired t test",
    "analysisId": "monteCarlo",
    "pluginVersion": 1,
    "input": {
     "source": "zid000001",
     "dataSets": []
    },
    "params": {
     "simulation": {
      "analysisId": "simulateColumn",
      "params": {
       "columns": [
        {
         "title": "Control",
         "n": 8,
         "mean": 100
        },
        {
         "title": "Treated",
         "n": 8,
         "mean": 115
        }
       ],
       "error": "gaussian",
       "sd": 15
      }
     },
     "analysis": {
      "analysisId": "ttest",
      "params": {},
      "dataSets": []
     },
     "simulations": 500,
     "seed": 11,
     "tabulate": [
      "p",
      "diff"
     ],
     "hits": {
      "combine": "both",
      "conditions": [
       {
        "value": "p",
        "op": "<",
        "than": 0.05
       }
      ]
     },
     "hitDenominator": "all",
     "alpha": 0.05,
     "confidenceLevel": 0.95
    }
   }
